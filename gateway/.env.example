# Copy this file to `.env` (same directory) and fill in a real key.
# The gateway loads .env at startup; it is gitignored.
#
# Get a key from https://console.anthropic.com/settings/keys
# A real API key starts with sk-ant-api03-…
# (sk-ant-usr-… tokens are Claude Code OAuth user tokens and will NOT work here.)
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
